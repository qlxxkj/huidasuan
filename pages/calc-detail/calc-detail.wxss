/* pages/calc-detail/calc-detail.wxss */
/* 复用 app.wxss 的 .site-grid/.result-* 等 */

.sub2 {
  font-size: 22rpx;
  color: #9AA0A6;
  font-weight: normal;
}

.pick-input {
  background: #F5F6FA;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1F2430;
  font-weight: 600;
}

.kv {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
}

.kv-row {
  flex: 1 1 45%;
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9AA0A6;
  padding: 6rpx 0;
}

.kv-row text:last-child {
  font-weight: 600;
  color: #1F2430;
}
