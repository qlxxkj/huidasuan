<!-- pages/history/history.wxml -->
<view class="container">

  <view class="card">
    <view class="card-title">我的利润 <text style="font-size:22rpx;color:#9AA0A6;font-weight:normal;">共 {{records.length}} 条</text></view>

    <block wx:if="{{records.length > 0}}">
      <view wx:for="{{records}}" wx:key="id" class="rec" bindtap="goDetail" data-id="{{item.id}}">
        <view style="display:flex;justify-content:space-between;align-items:center;">
          <view>
            <text class="rec-site">{{item.siteName}} · {{item.currency}}</text>
            <text class="rec-time">{{item.timeShort}}</text>
          </view>
          <text class="rec-profit {{item.netProfit >= 0 ? 'pos' : 'neg'}}">{{item.symbol}}{{item.netProfit}}</text>
        </view>
        <view class="rec-detail">
          售价 {{item.symbol}}{{item.price}} · 总成本 {{item.symbol}}{{item.totalCost}} · 利润率 {{item.profitMargin}}%
        </view>
      </view>
    </block>

    <view wx:if="{{records.length === 0}}" class="empty">
      <text style="font-size:80rpx;">📋</text>
      <view style="color:#9AA0A6;font-size:26rpx;margin-top:16rpx;">暂无记录，去计算页保存第一单吧</view>
    </view>
  </view>

  <button class="btn" bindtap="addNew">＋ 新建利润单</button>
  <button class="btn btn-ghost" style="margin-top:16rpx;" wx:if="{{records.length > 0}}" open-type="share">分享给好友</button>
  <button class="btn btn-ghost" style="margin-top:16rpx;" wx:if="{{records.length > 0}}" bindtap="exportText">导出文本</button>
  <button class="btn btn-ghost" style="margin-top:16rpx;" wx:if="{{records.length > 0}}" bindtap="exportCSV">导出 CSV</button>
  <button class="btn btn-plain" style="margin-top:16rpx;" wx:if="{{records.length > 0}}" bindtap="clearAll">清空全部记录</button>

  <view class="hint" style="text-align:center;margin-top:24rpx;">点按记录进入详情查看 / 编辑 / 删除</view>
</view>
