/* pages/pick/pick.wxss — 选品评分表单（样式与 pick-form 页一致） */
/* 选品表单样式（与旧表单页一致；列表页样式在 pages/pick/pick.wxss） */

/* 通用输入框 */
.inp {
  font-size: 28rpx;
  background: #F5F6FA;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #EEF0F4;
  color: #1F2430;
  font-weight: 600;
}

.inp-full {
  flex: 1;
  margin-left: 12rpx;
  width: auto;
  min-width: 200rpx;
}

/* picker 显示 */
.pick-v {
  background: #F5F6FA;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2430;
}

/* 维度卡片 */
.dim-card { position: relative; }
.dim-head { position: relative; }

.dim-weight {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 500;
  color: #9AA0A6;
  background: #F0F1F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.dim-weight.hot {
  color: #DC2626;
  background: #FEF2F2;
  font-weight: 600;
}

.dim-hot {
  border: 2rpx solid #FECACA;
  background: #FFFBFA;
}

/* 指标行 */
.dim-row {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F0F1F5;
}

.dim-row:last-child { border-bottom: none; }

.dim-row-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.dim-id {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F0F1F5;
  color: #4B5563;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dim-name {
  font-size: 26rpx;
  color: #1F2430;
  font-weight: 500;
}

.dim-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.dim-inp { width: 180rpx; font-size: 26rpx; }
.dim-hint { font-size: 22rpx; color: #9AA0A6; }

/* 评分行 */
.score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.score-lbl { font-size: 24rpx; color: #9AA0A6; flex-shrink: 0; }

.badge {
  min-width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  padding: 0 12rpx;
  background: #F0F1F5;
  color: #9AA0A6;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge.b1 { background: #FEE2E2; color: #DC2626; }
.badge.b2 { background: #FEF3C7; color: #D97706; }
.badge.b3 { background: #F3F4F6; color: #6B7280; }
.badge.b4 { background: #DBEAFE; color: #2563EB; }
.badge.b5 { background: #DCFCE7; color: #16A34A; }

/* 枚举 chips */
.enum-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F0F1F5;
  color: #4B5563;
  font-size: 24rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
}

.chip.on {
  background: #FFF4E6;
  color: #FF7A00;
  font-weight: 600;
  border-color: #FFD9B0;
}

.qmark {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF4E6;
  color: #FF7A00;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
}

.rule-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.rule-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx;
  max-height: 70vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.rule-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.rule-title { font-size: 30rpx; font-weight: 700; color: #1F2430; }
.rule-close { font-size: 32rpx; color: #9AA0A6; padding: 4rpx 12rpx; }

.rule-grade-row {
  font-size: 26rpx;
  color: #4B5563;
  padding: 10rpx 0;
  border-bottom: 2rpx solid #F0F1F5;
}

.rule-source {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #F7F8FB;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #9AA0A6;
  line-height: 1.6;
}

.dim-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  margin-top: 8rpx;
  border-top: 2rpx solid #F0F1F5;
}

.dim-foot-val { font-size: 32rpx; font-weight: 700; color: #1F2430; }

.result-card { background: #fff; }

.score-hero {
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #E5E7EB, #F3F4F6);
  color: #6B7280;
}

.score-hero .big { font-size: 64rpx; font-weight: 700; line-height: 1.1; }
.score-hero .label { font-size: 24rpx; opacity: 0.9; }

.score-hero.good { background: linear-gradient(135deg, #16A34A, #4ADE80); color: #fff; }
.score-hero.ok   { background: linear-gradient(135deg, #D97706, #FBBF24); color: #fff; }
.score-hero.mid  { background: linear-gradient(135deg, #6B7280, #9CA3AF); color: #fff; }
.score-hero.bad  { background: linear-gradient(135deg, #DC2626, #F87171); color: #fff; }

.verdict-emoji { font-size: 60rpx; }

.verdict-text { font-size: 28rpx; font-weight: 600; padding: 8rpx 4rpx; }
.verdict-text.good { color: #16A34A; }
.verdict-text.ok   { color: #D97706; }
.verdict-text.mid  { color: #6B7280; }
.verdict-text.bad  { color: #DC2626; }

.legend { margin-top: 12rpx; }

.legend-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #4B5563;
}

.legend-row .sub { flex-shrink: 0; width: 100rpx; color: #9AA0A6; font-weight: 600; }
