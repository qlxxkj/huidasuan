/* pages/mine/mine.wxss */
/* 全局样式见 app.wxss */

.me {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.me__avatar-btn {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: visible;
  background: transparent;
  line-height: 1;
}
.me__avatar-btn::after { border: none; }

.me__avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F0F1F5;
  display: block;
}

.me__badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FF9900;
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.me__info { flex: 1; min-width: 0; }

.me__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2430;
  background: transparent;
  padding: 0;
}

.me__ph { font-size: 32rpx; color: #9AA0A6; font-weight: 500; }

.me__stat {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9AA0A6;
}

/* 分组卡片 */
.group { padding: 0 8rpx; }

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 20rpx;
}

.row:active { background: #F7F8FB; }

.row__emoji { font-size: 36rpx; flex-shrink: 0; }

.row__label {
  font-size: 28rpx;
  color: #1F2430;
  font-weight: 500;
  flex: 1;
}

.row__value {
  font-size: 24rpx;
  color: #9AA0A6;
}

.row__arrow {
  font-size: 36rpx;
  color: #C7CBD1;
  flex-shrink: 0;
}

.hr {
  height: 2rpx;
  background: #F0F1F5;
  margin: 0 20rpx;
}

/* 区块标题 */
.section-title {
  margin: 28rpx 8rpx 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4B5563;
}
