/* pages/mine/mine.wxss */

/* ---------- 头像 + 昵称（昵称紧贴头像，相机按钮在头像右下角） ---------- */
.me {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.me__avatar-wrap {
  position: relative;
  flex: 0 0 120rpx;
  width: 120rpx;
  height: 120rpx;
}

.me__avatar-btn {
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: visible;
  background: transparent;
  line-height: 1;
}
.me__avatar-btn::after { border: none; }

.me__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F0F1F5;
  display: block;
}

.me__badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.me__badge text {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #FF9900;
  color: #fff;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.me__info {
  flex: 1;
  min-width: 0;
}

.me__name {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2430;
  background: transparent;
  padding: 0;
}

.me__ph { font-size: 30rpx; color: #9AA0A6; font-weight: 500; }

.me__stat {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9AA0A6;
}

/* ---------- 分组卡片 ---------- */
.group { padding: 0 8rpx; }

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 20rpx;
}

.row:active { background: #F7F8FB; }

.row__emoji { font-size: 36rpx; flex-shrink: 0; }

.row__label {
  font-size: 28rpx;
  color: #1F2430;
  font-weight: 500;
  flex: 1;
}

.row__value {
  font-size: 24rpx;
  color: #9AA0A6;
}

.row__arrow {
  font-size: 36rpx;
  color: #C7CBD1;
  flex-shrink: 0;
}

.hr {
  height: 2rpx;
  background: #F0F1F5;
  margin: 0 20rpx;
}

/* ---------- 区块标题 ---------- */
.section-title {
  margin: 28rpx 8rpx 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #4B5563;
}
