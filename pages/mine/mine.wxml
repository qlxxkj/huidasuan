<!-- pages/mine/mine.wxml -->
<view class="container">

  <!-- 头像 / 昵称 -->
  <view class="card me">
    <view class="me__avatar-wrap">
      <button class="me__avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="me__avatar" src="{{avatar || '/assets/avatar-default.png'}}" mode="aspectFill" />
      </button>
      <view class="me__badge"><text>✎</text></view>
    </view>
    <view class="me__info">
      <input
        class="me__name"
        type="nickname"
        value="{{nick}}"
        placeholder="点击设置昵称"
        placeholder-class="me__ph"
        maxlength="16"
        bindinput="onNickInput"
        bindblur="onNickBlur"
      />
      <view class="me__stat">FBA 卖家工作台</view>
    </view>
  </view>

  <!-- 我的收藏（入口） -->
  <view class="section-title">我的收藏</view>
  <view class="card group">
    <view class="row" bindtap="goProfit">
      <text class="row__emoji">💰</text>
      <text class="row__label">我的利润</text>
      <text class="row__value">{{profitCount ? profitCount + ' 条' : '暂无'}}</text>
      <text class="row__arrow">›</text>
    </view>
    <view class="hr"></view>
    <view class="row" bindtap="goPicks">
      <text class="row__emoji">🧺</text>
      <text class="row__label">我的选品</text>
      <text class="row__value">{{pickCount ? pickCount + ' 条' : '暂无'}}</text>
      <text class="row__arrow">›</text>
    </view>
  </view>

  <!-- 我的设置 -->
  <view class="section-title">我的设置</view>
  <view class="card group">
    <view class="row">
      <text class="row__emoji">🏷️</text>
      <text class="row__label">当前版本</text>
      <text class="row__value">v{{version}}</text>
    </view>
  </view>

  <button class="btn btn-ghost" style="margin-top:32rpx;" open-type="share">分享给好友</button>

  <view class="hint" style="text-align:center;margin-top:24rpx;">FBA 利润计算器 · 选品评分</view>
</view>
