<!-- pages/fx/fx.wxml -->
<view class="container">

  <!-- 汇率来源状态条 -->
  <view class="fx-source-bar">
    <view wx:if="{{loading}}" class="fx-source-loading">
      <text class="fx-spinner"></text>
      <text>正在获取实时汇率…</text>
    </view>
    <view wx:elif="{{source === 'failed'}}" class="fx-source-failed">
      <text>网络异常，使用离线内置汇率</text>
      <text class="fx-refresh-btn" bindtap="refreshRates">刷新</text>
    </view>
    <view wx:elif="{{source === 'local'}}" class="fx-source-local">
      <text>本地缓存 · {{updatedAt}}</text>
      <text class="fx-refresh-btn" bindtap="refreshRates">刷新</text>
    </view>
    <view wx:else class="fx-source-ok">
      <text class="fx-source-dot"></text>
      <text>{{source === 'api' ? '实时汇率' : '数据库缓存'}} · {{updatedAt}}</text>
    </view>
  </view>

  <!-- 互换区 -->
  <view class="card">
    <view class="card-title">币种互换</view>

    <!-- 第一行：输入 + from picker -->
    <view class="fx-exchange-row">
      <view class="fx-left-col">
        <input
          type="digit"
          value="{{amount}}"
          bindinput="onAmountInput"
          bindblur="onAmountBlur"
          placeholder="输入金额"
          class="fx-amount-input"
        />
      </view>
      <view class="fx-right-col">
        <picker
          class="fx-currency-picker"
          range="{{currencyList}}"
          range-key="code"
          value="{{fromIdx}}"
          bindchange="onFromPick"
        >
          <view class="fx-currency-chip">
            <text class="fx-chip-code">{{fromCurrency}}</text>
            <text class="fx-chip-name">{{currencyList[fromIdx].name}}</text>
            <text class="fx-chip-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 第二行：swap + 结果 + to picker -->
    <view class="fx-exchange-row fx-row-result">
      <view class="fx-left-col">
        <view class="fx-result-inner">
          <view class="fx-swap-btn" bindtap="onSwap">
            <text class="fx-swap-icon">⇅</text>
          </view>
          <text class="fx-result-value">{{resultText}}</text>
        </view>
      </view>
      <view class="fx-right-col">
        <picker
          class="fx-currency-picker"
          range="{{currencyList}}"
          range-key="code"
          value="{{toIdx}}"
          bindchange="onToPick"
        >
          <view class="fx-currency-chip fx-currency-chip-result">
            <text class="fx-chip-code">{{toCurrency}}</text>
            <text class="fx-chip-name">{{currencyList[toIdx].name}}</text>
            <text class="fx-chip-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="fx-rate-line">
      100 {{fromCurrency}} = {{rate100Text}} {{toCurrency}}
    </view>
  </view>

  <!-- 货币汇率（可手动覆盖） -->
  <view class="card">
    <view class="card-title">货币汇率</view>
    <view class="fx-table">
      <view class="fx-table-header">
        <text class="fx-th">币种</text>
        <text class="fx-th fx-th-rate">汇率</text>
        <text class="fx-th fx-th-100">100外币 = CNY</text>
      </view>
      <view
        wx:for="{{currencyList}}"
        wx:key="code"
        wx:if="{{item.code !== 'CNY'}}"
        class="fx-table-row"
      >
        <text class="fx-td">{{item.code}} {{item.name}}</text>
        <view class="fx-td fx-td-edit">
          <input
            type="digit"
            value="{{item.rateDisplay}}"
            data-code="{{item.code}}"
            bindinput="onRateInput"
            placeholder="—"
            class="fx-rate-input"
          />
        </view>
        <text class="fx-td fx-td-100">{{item.rate100}}</text>
      </view>
    </view>
    <view class="fx-table-hint">
      汇率列可手动修改（1 外币 = ? 人民币，填 0 恢复实时值）。
    </view>
  </view>

  <!-- 最近互换 -->
  <view class="card">
    <view class="card-title">最近互换</view>
    <view wx:if="{{history.length === 0}}" class="fx-empty">暂无记录</view>
    <view
      wx:for="{{history}}"
      wx:key="id"
      class="fx-history-item"
      data-idx="{{index}}"
      bindtap="onHistoryTap"
    >
      <view class="fx-history-main">
        <text class="fx-history-amount">{{item.amount}} {{item.from}}</text>
        <text class="fx-history-arrow">→</text>
        <text class="fx-history-result">{{item.result}} {{item.to}}</text>
      </view>
      <view class="fx-history-sub">
        <text>1 {{item.from}} = {{item.rate}} {{item.to}}</text>
        <text class="fx-history-time">{{item.time}}</text>
      </view>
    </view>
  </view>

</view>
